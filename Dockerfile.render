FROM node:22-bookworm-slim AS client-build
WORKDIR /workspace/client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
RUN npm run build

FROM node:22-bookworm-slim AS server-build
WORKDIR /workspace/server
COPY server/package.json server/package-lock.json ./
RUN npm ci
COPY server/prisma ./prisma
COPY server/prisma.config.ts server/tsconfig.json ./
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
COPY server/src ./src
RUN npx prisma generate
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY server/package.json server/package-lock.json ./
COPY --from=server-build /workspace/server/node_modules ./node_modules
COPY --from=server-build /workspace/server/prisma ./prisma
COPY --from=server-build /workspace/server/prisma.config.ts ./prisma.config.ts
COPY --from=server-build /workspace/server/src/generated ./src/generated
COPY --from=server-build /workspace/server/dist ./dist
COPY --from=client-build /workspace/client/dist ./public
EXPOSE 10000
CMD ["sh", "-c", "npm run db:migrate:deploy && npm run start"]

