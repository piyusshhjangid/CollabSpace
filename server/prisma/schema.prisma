generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model projects {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id     String              @db.Uuid
  name             String
  description      String?
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  workspaces       workspaces          @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks            tasks[]
  outcome_id       String?             @db.Uuid
  outcomes         outcomes?           @relation(fields: [outcome_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dependencies     task_dependencies[]
  execution_events execution_events[]
  task_evidence    task_evidence[]
  task_truth       task_truth[]
  ai_proposals     ai_proposals[]
  execution_history_snapshots execution_history_snapshots[]
  execution_scenarios execution_scenarios[]
  recovery_plans recovery_plans[]
  agent_runs agent_runs[]
  integration_events integration_events[]
  external_integrations external_integrations[]
  execution_scenario_runs execution_scenario_runs[]
  ai_evaluations ai_evaluations[]
  integration_oauth_states integration_oauth_states[]
}

model tasks {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_key         String?            @unique(map: "uq_tasks_task_key") @db.VarChar(20)
  project_id       String             @db.Uuid
  workspace_id     String             @db.Uuid
  assigned_to      String?            @db.Uuid
  title            String
  completed        Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  completed_at     DateTime?          @db.Timestamptz(6)
  status           String             @default("TODO")
  due_date         DateTime?          @db.Timestamptz(6)
  task_evidence    task_evidence[]
  execution_events execution_events[]
  task_truth       task_truth?

  users                 users?                 @relation(fields: [assigned_to], references: [id], onUpdate: NoAction)
  projects              projects               @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces            workspaces             @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status_history        task_status_history[]
  outgoing_dependencies task_dependencies[]    @relation("dependency_predecessor")
  incoming_dependencies task_dependencies[]    @relation("dependency_successor")
  plan_snapshots        execution_plan_tasks[]
  integration_events    integration_events[]
  integration_resource_links integration_resource_links[]

  @@index([assigned_to], map: "idx_tasks_assigned_to")
  @@index([project_id], map: "idx_tasks_project_id")
  @@index([status], map: "idx_tasks_status")
  @@index([workspace_id], map: "idx_tasks_workspace_id")
  @@index([workspace_id, status, due_date], map: "idx_tasks_workspace_status_due")
}

model task_status_history {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String   @db.Uuid
  workspace_id String   @db.Uuid
  from_status  String?
  to_status    String
  changed_by   String   @db.Uuid
  changed_at   DateTime @default(now()) @db.Timestamptz(6)

  tasks      tasks      @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users      @relation(fields: [changed_by], references: [id], onUpdate: NoAction)

  @@index([task_id, changed_at], map: "idx_task_status_history_task_changed")
  @@index([workspace_id, changed_at], map: "idx_task_status_history_workspace_changed")
}

model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                @unique
  password_hash       String
  name                String
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  tasks               tasks[]
  workspace_members   workspace_members[]
  refresh_tokens      refresh_tokens[]
  invitations_sent    invitations[]
  task_status_changes task_status_history[]
  idempotency_records idempotency_records[]
  execution_history_snapshots execution_history_snapshots[]
  execution_scenarios execution_scenarios[]
  recovery_plans_created recovery_plans[] @relation("recovery_created_by")
  recovery_plans_decided recovery_plans[] @relation("recovery_decided_by")
  agent_runs agent_runs[]
  knowledge_documents knowledge_documents[]
  external_integrations external_integrations[]
  integration_oauth_states integration_oauth_states[]
  integration_sync_jobs integration_sync_jobs[] @relation("integration_sync_requested_by")
}

model idempotency_records {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  idempotency_key String   @db.VarChar(200)
  request_hash    String   @db.VarChar(64)
  state           String   @default("PROCESSING") @db.VarChar(16)
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, idempotency_key], map: "uq_idempotency_user_key")
  @@index([created_at], map: "idx_idempotency_created_at")
}

model workspace_members {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String     @db.Uuid
  workspace_id String     @db.Uuid
  role         String     @default("member")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([user_id, workspace_id])
}

model outcomes {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String               @db.Uuid
  name               String
  description        String?
  success_criteria   Json
  target_date        DateTime?            @db.Date
  owner_id           String?              @db.Uuid
  created_by         String               @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces         workspaces           @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  goals              goals[]
  projects           projects[]
  delivery_contracts delivery_contracts[]
  execution_plans    execution_plans[]

  @@index([workspace_id, target_date], map: "idx_outcomes_workspace_target")
}

model goals {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id     String       @db.Uuid
  outcome_id       String       @db.Uuid
  name             String
  success_criteria Json
  target_date      DateTime?    @db.Date
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  outcomes         outcomes     @relation(fields: [outcome_id], references: [id], onDelete: Cascade)
  workspaces       workspaces   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  milestones       milestones[]

  @@index([workspace_id, outcome_id], map: "idx_goals_workspace_outcome")
}

model milestones {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  goal_id      String     @db.Uuid
  name         String
  due_date     DateTime?  @db.Date
  status       String     @default("UPCOMING")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  goals        goals      @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, goal_id, due_date], map: "idx_milestones_workspace_goal_due")
}

model task_dependencies {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String     @db.Uuid
  project_id          String     @db.Uuid
  predecessor_task_id String     @db.Uuid
  successor_task_id   String     @db.Uuid
  dependency_type     String     @default("FINISH_TO_START")
  created_by          String     @db.Uuid
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  workspaces          workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects            projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  predecessor         tasks      @relation("dependency_predecessor", fields: [predecessor_task_id], references: [id], onDelete: Cascade)
  successor           tasks      @relation("dependency_successor", fields: [successor_task_id], references: [id], onDelete: Cascade)

  @@unique([predecessor_task_id, successor_task_id], map: "uq_task_dependency_edge")
  @@index([workspace_id, project_id], map: "idx_task_dependencies_workspace_project")
}

model delivery_contracts {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String     @db.Uuid
  outcome_id          String     @db.Uuid
  version             Int
  scope               String
  deadline            DateTime?  @db.Date
  constraints         Json
  acceptance_criteria Json
  owner_id            String?    @db.Uuid
  created_by          String     @db.Uuid
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  workspaces          workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  outcomes            outcomes   @relation(fields: [outcome_id], references: [id], onDelete: Cascade)

  @@unique([outcome_id, version], map: "uq_delivery_contract_outcome_version")
  @@index([workspace_id, outcome_id, version], map: "idx_contracts_workspace_outcome_version")
}

model execution_plans {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String                 @db.Uuid
  outcome_id   String                 @db.Uuid
  contract_id  String?                @db.Uuid
  version      Int
  created_by   String                 @db.Uuid
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  workspaces   workspaces             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  outcomes     outcomes               @relation(fields: [outcome_id], references: [id], onDelete: Cascade)
  tasks        execution_plan_tasks[]
  edges        execution_plan_edges[]

  @@unique([outcome_id, version], map: "uq_execution_plan_outcome_version")
  @@index([workspace_id, outcome_id, version], map: "idx_execution_plans_workspace_outcome_version")
}

model execution_plan_tasks {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id       String          @db.Uuid
  task_id       String?         @db.Uuid
  task_title    String
  planned_start DateTime?       @db.Date
  planned_end   DateTime?       @db.Date
  duration_days Int             @default(1)
  order_index   Int
  plans         execution_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  tasks         tasks?          @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@unique([plan_id, task_id], map: "uq_execution_plan_task")
  @@index([plan_id, order_index], map: "idx_execution_plan_tasks_order")
}

model execution_plan_edges {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id             String          @db.Uuid
  predecessor_task_id String          @db.Uuid
  predecessor_title   String
  successor_task_id   String          @db.Uuid
  successor_title     String
  dependency_type     String
  plans               execution_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, predecessor_task_id, successor_task_id], map: "uq_execution_plan_edge")
  @@index([plan_id], map: "idx_execution_plan_edges_plan")
}

model workspace_event_counters {
  workspace_id String     @id @db.Uuid
  sequence     BigInt     @default(0)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model workspaces {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  created_at          DateTime                  @default(now()) @db.Timestamptz(6)
  projects            projects[]
  tasks               tasks[]
  workspace_members   workspace_members[]
  invitations         invitations[]
  task_status_history task_status_history[]
  outcomes            outcomes[]
  goals               goals[]
  milestones          milestones[]
  task_dependencies   task_dependencies[]
  delivery_contracts  delivery_contracts[]
  execution_plans     execution_plans[]
  event_counter       workspace_event_counters?
  github_integrations github_integrations[]
  execution_events    execution_events[]
  task_evidence       task_evidence[]
  task_truth          task_truth[]
  ai_proposals        ai_proposals[]
  execution_history_snapshots execution_history_snapshots[]
  execution_scenarios execution_scenarios[]
  execution_scenario_runs execution_scenario_runs[]
  recovery_plans recovery_plans[]
  recovery_jobs recovery_jobs[]
  agent_runs agent_runs[]
  knowledge_documents knowledge_documents[]
  knowledge_chunks knowledge_chunks[]
  external_integrations external_integrations[]
  integration_events integration_events[]
  integration_sync_jobs integration_sync_jobs[]
  ai_evaluations ai_evaluations[]
  integration_oauth_states integration_oauth_states[]
  integration_resource_links integration_resource_links[]
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([token], map: "idx_refresh_tokens_token")
}

model invitations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String    @db.Uuid
  invited_by    String    @db.Uuid
  email         String
  token         String    @unique
  expires_at    DateTime  @db.Timestamptz(6)
  accepted_at   DateTime? @db.Timestamptz(6)
  email_sent_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  users      users      @relation(fields: [invited_by], references: [id], onDelete: Cascade)

  @@index([workspace_id], map: "idx_invitations_workspace_id")
  @@index([email], map: "idx_invitations_email")
  @@index([token], map: "idx_invitations_token")
}

model audit_log {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String?  @db.Uuid
  actor_id     String?  @db.Uuid
  action       String
  target_type  String
  target_id    String?
  metadata     Json
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([workspace_id, created_at], map: "idx_audit_log_workspace_created")
  @@index([actor_id, created_at], map: "idx_audit_log_actor_created")
  @@index([action, created_at], map: "idx_audit_log_action_created")
}

model github_integrations {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String      @db.Uuid
  project_id   String      @db.Uuid
  repository   String      @unique(map: "uq_github_integration_repository") @db.VarChar(255)
  enabled      Boolean     @default(true)
  created_by   String      @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([enabled], map: "idx_github_integration_enabled")
}

model github_webhook_deliveries {
  delivery_id  String    @id @db.VarChar(100)
  repository   String    @db.VarChar(255)
  event_type   String    @db.VarChar(80)
  status       String    @default("RECEIVED") @db.VarChar(20)
  payload      Json
  received_at  DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  error_code   String?   @db.VarChar(80)

  @@index([status, received_at], map: "idx_github_delivery_status_received")
  @@index([repository, received_at], map: "idx_github_delivery_repo_received")
}

model execution_events {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String     @db.Uuid
  project_id      String     @db.Uuid
  task_id         String?    @db.Uuid
  integration_id  String     @db.Uuid
  source          String     @db.VarChar(30)
  external_id     String     @db.VarChar(160)
  event_type      String     @db.VarChar(80)
  action          String?    @db.VarChar(80)
  actor           String?    @db.VarChar(255)
  title           String
  body            String?
  url             String?
  branch          String?
  occurred_at     DateTime   @db.Timestamptz(6)
  link_confidence Float      @default(0)
  metadata        Json
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  workspaces      workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects        projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks           tasks?     @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@unique([source, external_id], map: "uq_execution_event_source_external")
  @@index([workspace_id, occurred_at(sort: Desc)], map: "idx_execution_events_workspace_time")
  @@index([project_id, occurred_at(sort: Desc)], map: "idx_execution_events_project_time")
  @@index([task_id, occurred_at(sort: Desc)], map: "idx_execution_events_task_time")
}

model task_evidence {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String     @db.Uuid
  project_id      String     @db.Uuid
  task_id         String     @db.Uuid
  event_id        String     @db.Uuid
  evidence_type   String     @db.VarChar(50)
  observed_status String     @db.VarChar(30)
  confidence      Float
  explanation     String
  provenance      Json
  captured_at     DateTime   @db.Timestamptz(6)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  workspaces      workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects        projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks           tasks      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, event_id], map: "uq_task_evidence_task_event")
  @@index([workspace_id, task_id, captured_at(sort: Desc)], map: "idx_task_evidence_workspace_task_time")
}

model task_truth {
  task_id         String     @id @db.Uuid
  workspace_id    String     @db.Uuid
  project_id      String     @db.Uuid
  declared_status String     @db.VarChar(30)
  observed_status String     @db.VarChar(30)
  confidence      Float
  explanation     String
  evidence_count  Int        @default(0)
  reconciled_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspaces      workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects        projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks           tasks      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, project_id, observed_status], map: "idx_task_truth_workspace_project_status")
}

model ai_proposals {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  project_id   String     @db.Uuid
  created_by   String     @db.Uuid
  kind         String     @db.VarChar(40)
  payload      Json
  status       String     @default("PENDING") @db.VarChar(20)
  decided_by   String?    @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  decided_at   DateTime?  @db.Timestamptz(6)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, project_id, status, created_at], map: "idx_ai_proposals_workspace_project_status")
}

model execution_history_snapshots {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  project_id   String     @db.Uuid
  captured_by  String     @db.Uuid
  snapshot     Json
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users        users      @relation(fields: [captured_by], references: [id], onDelete: Cascade)

  @@index([workspace_id, project_id, created_at(sort: Desc)], map: "idx_execution_history_project_time")
}

model execution_scenarios {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String                    @db.Uuid
  project_id   String                    @db.Uuid
  created_by   String                    @db.Uuid
  name         String                    @db.VarChar(120)
  changes      Json
  created_at   DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces   workspaces                @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects                  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users        users                     @relation(fields: [created_by], references: [id], onDelete: Cascade)
  runs         execution_scenario_runs[]

  @@index([workspace_id, project_id, created_at(sort: Desc)], map: "idx_execution_scenarios_project_time")
}

model execution_scenario_runs {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenario_id     String              @db.Uuid
  workspace_id    String              @db.Uuid
  project_id      String              @db.Uuid
  input_hash      String              @db.VarChar(64)
  input_snapshot  Json
  result          Json
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  scenarios       execution_scenarios @relation(fields: [scenario_id], references: [id], onDelete: Cascade)
  workspaces      workspaces          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects        projects            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([scenario_id, input_hash], map: "uq_execution_scenario_run_input")
  @@index([workspace_id, project_id, created_at(sort: Desc)], map: "idx_execution_scenario_runs_project_time")
}

model recovery_plans {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String     @db.Uuid
  project_id   String     @db.Uuid
  created_by   String     @db.Uuid
  name         String     @db.VarChar(120)
  status       String     @default("PENDING") @db.VarChar(20)
  root_cause   Json
  options      Json
  selected_option_key String? @db.VarChar(80)
  decided_by   String?    @db.Uuid
  decided_at   DateTime?  @db.Timestamptz(6)
  verification Json?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator      users      @relation("recovery_created_by", fields: [created_by], references: [id], onDelete: Cascade)
  decider      users?     @relation("recovery_decided_by", fields: [decided_by], references: [id], onDelete: SetNull)
  jobs         recovery_jobs[]

  @@index([workspace_id, project_id, status, created_at(sort: Desc)], map: "idx_recovery_plans_project_status")
}

model agent_runs {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String     @db.Uuid
  project_id      String     @db.Uuid
  requested_by    String     @db.Uuid
  agent_type      String     @db.VarChar(24)
  status          String     @default("QUEUED") @db.VarChar(20)
  input           Json
  result          Json?
  budget_limit    Int        @default(1000)
  budget_used     Int        @default(0)
  idempotency_key String?    @db.VarChar(120)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  finished_at     DateTime?  @db.Timestamptz(6)
  workspaces      workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects        projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users           users      @relation(fields: [requested_by], references: [id], onDelete: Cascade)
  steps           agent_run_steps[]
  evaluations     ai_evaluations[]

  @@unique([workspace_id, requested_by, idempotency_key], map: "uq_agent_run_idempotency")
  @@index([workspace_id, project_id, created_at(sort: Desc)], map: "idx_agent_runs_project_time")
}

model agent_run_steps {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id      String    @db.Uuid
  step_index  Int
  agent_role  String    @db.VarChar(24)
  status      String    @db.VarChar(20)
  input       Json
  result      Json?
  citations   Json
  started_at  DateTime  @default(now()) @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  runs        agent_runs @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([run_id, step_index], map: "uq_agent_run_step")
  @@index([run_id, started_at], map: "idx_agent_run_steps_run_time")
}

model knowledge_documents {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String           @db.Uuid
  created_by   String           @db.Uuid
  title        String           @db.VarChar(240)
  source_type  String           @db.VarChar(24)
  source_url   String?
  content_hash String           @db.VarChar(64)
  content      String
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces   workspaces       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  users        users            @relation(fields: [created_by], references: [id], onDelete: Cascade)
  chunks       knowledge_chunks[]

  @@unique([workspace_id, content_hash], map: "uq_knowledge_document_hash")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_knowledge_documents_workspace_time")
}

model knowledge_chunks {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String             @db.Uuid
  document_id  String             @db.Uuid
  chunk_index  Int
  heading      String?            @db.VarChar(240)
  content      String
  embedding    Json?
  search_vector Unsupported("tsvector")?
  embedding_vector Unsupported("vector(768)")?
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  workspaces   workspaces         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  documents    knowledge_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, chunk_index], map: "uq_knowledge_chunk_order")
  @@index([workspace_id, document_id], map: "idx_knowledge_chunks_workspace_document")
}

model external_integrations {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String     @db.Uuid
  project_id           String?    @db.Uuid
  created_by           String     @db.Uuid
  provider             String     @db.VarChar(24)
  external_account_id  String     @db.VarChar(240)
  display_name         String     @db.VarChar(240)
  base_url              String?
  credentials_ciphertext String?
  config                Json
  status                String    @default("ACTIVE") @db.VarChar(20)
  last_synced_at        DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  workspaces            workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects              projects?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users                 users      @relation(fields: [created_by], references: [id], onDelete: Cascade)
  events                integration_events[]
  sync_jobs             integration_sync_jobs[]

  @@unique([workspace_id, provider, external_account_id], map: "uq_external_integration_scope")
  @@index([workspace_id, provider, status], map: "idx_external_integrations_provider_status")
}

model integration_events {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String               @db.Uuid
  project_id     String               @db.Uuid
  integration_id String               @db.Uuid
  task_id        String?              @db.Uuid
  provider       String               @db.VarChar(24)
  external_id    String               @db.VarChar(200)
  event_type     String               @db.VarChar(80)
  actor          String?
  title          String
  body           String?
  url            String?
  occurred_at    DateTime             @db.Timestamptz(6)
  metadata       Json
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  workspaces     workspaces           @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects       projects             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  integrations   external_integrations @relation(fields: [integration_id], references: [id], onDelete: Cascade)
  tasks          tasks?               @relation(fields: [task_id], references: [id], onDelete: SetNull)

  @@unique([integration_id, external_id], map: "uq_integration_event_external")
  @@index([workspace_id, project_id, occurred_at(sort: Desc)], map: "idx_integration_events_project_time")
}

model integration_resource_links {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id      String    @db.Uuid
  task_id            String    @db.Uuid
  provider           String    @db.VarChar(24)
  external_id        String    @db.VarChar(200)
  external_url       String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  tasks              tasks     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  workspaces         workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, provider, external_id], map: "uq_integration_resource_external")
  @@index([workspace_id, task_id], map: "idx_integration_resource_task")
}

model recovery_jobs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id      String     @unique(map: "uq_recovery_job_plan") @db.Uuid
  workspace_id String     @db.Uuid
  status       String     @default("PENDING") @db.VarChar(16)
  attempts     Int        @default(0)
  available_at DateTime   @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?  @db.Timestamptz(6)
  last_error   String?    @db.VarChar(120)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  plans        recovery_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([status, available_at], map: "idx_recovery_jobs_poll")
}

model ai_evaluations {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String      @db.Uuid
  project_id   String?     @db.Uuid
  run_id       String?     @db.Uuid
  case_key     String      @db.VarChar(120)
  passed       Boolean
  metrics      Json
  latency_ms   Int?
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  workspaces   workspaces  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects?   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  runs         agent_runs? @relation(fields: [run_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at(sort: Desc)], map: "idx_ai_evaluations_workspace_time")
}

model integration_oauth_states {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state_hash   String      @unique(map: "uq_integration_oauth_state_hash") @db.VarChar(64)
  workspace_id String      @db.Uuid
  project_id   String?     @db.Uuid
  user_id      String      @db.Uuid
  provider     String      @db.VarChar(24)
  provider_config Json     @default("{}")
  expires_at   DateTime    @db.Timestamptz(6)
  consumed_at  DateTime?   @db.Timestamptz(6)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  workspaces   workspaces  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projects     projects?   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at], map: "idx_integration_oauth_states_expiry")
}

model integration_sync_jobs {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String      @db.Uuid
  integration_id String      @db.Uuid
  requested_by   String      @db.Uuid
  status         String      @default("PENDING") @db.VarChar(16)
  attempts       Int         @default(0)
  available_at   DateTime    @default(now()) @db.Timestamptz(6)
  locked_at      DateTime?   @db.Timestamptz(6)
  error_code     String?     @db.VarChar(100)
  result         Json?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  finished_at    DateTime?   @db.Timestamptz(6)
  workspaces     workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  integrations   external_integrations @relation(fields: [integration_id], references: [id], onDelete: Cascade)
  requester      users       @relation("integration_sync_requested_by", fields: [requested_by], references: [id], onDelete: Cascade)

  @@index([status, available_at], map: "idx_integration_sync_jobs_poll")
  @@index([integration_id, created_at(sort: Desc)], map: "idx_integration_sync_jobs_integration_time")
}
